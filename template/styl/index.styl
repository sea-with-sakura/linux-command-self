@import('mixins/reset.styl')
@import('mixins/markdown.styl')

mq-mobile = "screen and (max-width: 479px)"

[data-color-mode*='dark'], [data-color-mode*='dark'] body {
  color-scheme: dark;
  --color-header-bg: #3a3a3a8f;
  --color-header-border: #323232;
  --color-hover: #ffffff30;
}
[data-color-mode*='light'], [data-color-mode*='light'] body {
  color-scheme: light;
  --color-header-bg: #ffffff52;
  --color-header-border: #d3d3d3;
  --color-hover: #f2f2f2;
}

.warpper {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.home-actions {
  display flex
  justify-content center
  margin-top 28px
  a {
    border 1px solid var(--color-header-border)
    border-radius 6px
    color currentColor
    font-size 14px
    font-weight bold
    padding 10px 18px
    text-decoration none
  }
  a:hover {
    background var(--color-hover)
  }
}

.recent-visits {
  margin 24px auto 0
  max-width 720px
  padding 0 18px
  width 100%
}

.recent-visits-title {
  color #666
  font-size 13px
  font-weight bold
  margin 0 0 10px
  text-align center
}

.recent-visits-list {
  display grid
  gap 8px
  grid-template-columns repeat(2, minmax(0, 1fr))
}

.recent-visit-item {
  border 1px solid var(--color-header-border)
  border-radius 8px
  color currentColor
  display block
  min-width 0
  padding 10px 12px
  text-decoration none
  transition background-color .15s, border-color .15s
  strong {
    display block
    font-size 14px
    line-height 1.35
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
  }
  span {
    color #777
    display block
    font-size 12px
    line-height 1.35
    margin-top 4px
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
  }
  &:hover {
    background var(--color-hover)
    border-color #66afe9
  }
}

.header {
  width 517px
  margin 0 auto 0
  padding 0 10px
  .logo a {
    display flex
    color: currentColor;
  }
  .box {
    position relative
  }
  .search {
    min-height 20px
    position relative
    display table
    border-collapse separate
    li,ul {
      list-style none
    }
    #result {
      .ok {
        background:#f4f4f4;
      }
    }
    .search-list {
      position absolute
      display none
      z-index 999
      box-shadow 1px 1px 3px var(--color-theme-bg)
      border 1px solid var(--color-header-border)
      background var(--color-theme-bg)
      min-width 100px
      top 39px
      width 100%
      padding 5px
      border-radius 5px 5px 5px 5px
      li {
        line-height 23px
        span{
          padding 0 8px
          color #b9b9b9
        }
      }
      a {
        display block
        padding 2px 6px 2px 6px
        &:hover {
          background-color var(--color-hover)
        }
        .kw {
          color #f00
          font-style inherit
          font-weight bold
        }
      }
    }
    .query, .enter-input {
      display table-cell
      transition border-color ease-in-out 0.15s, box-shadow ease-in-out 0.15s
    }
    .query {
      resize: none;
      position relative
      z-index 2
      width 100%
      height 40px
      padding 6px 12px
      font-size 14px
      font-weight bold
      line-height 1.42857143
      background-color: transparent;
      background-image none
      border 1px solid $border-color
      border-radius 5px 0 0 5px
      -webkit-appearance: none;
      &:focus {
        z-index 99
        border-color #66afe9
        outline 0
        box-shadow inset 0 1px 1px rgba(0,0,0,0.075),0 0 8px rgba(102,175,233,0.6)
      }
    }
    .enter-input {
      white-space nowrap
      button {
        margin 0
        left -1px
        position relative
        z-index 5
        display inline-block
        padding 9px 23px
        font-size 14px
        font-weight bold
        line-height 1.42857143
        text-align center
        text-rendering auto
        white-space nowrap
        vertical-align middle
        touch-action manipulation
        cursor pointer
        user-select none
        background-image none
        border 1px solid transparent
        border-collapse separate
        border-radius 0 5px 5px 0
        border-color $border-color
        &:focus,&:active:focus {
          outline thin dotted
          outline 5px auto -webkit-focus-ring-color
          outline-offset -2px
        }
        &:active {
          color #333
          background-color #e6e6e6
          border-color #b4b4b4
          background-image none
          box-shadow inset 0 8px 32px -8px rgba(0,0,0,0.3)
        }
        &:focus {
          color #333
          background-color #e6e6e6
          border-color #999
          text-decoration none
        }
        &:hover {
          color #333
          background-color #e6e6e6
          border-color #b4b4b4
        }
      }
    }
  }
}

.header.home {
  .header_inner {
    display flex
    flex-direction column
    align-items center
  }
  .logo {
    min-height 140px
    display flex
    align-items center
  }
  .search {
    display flex
    min-width 320px
  }
}

.header.header_list {
  width auto
  position fixed
  width 100%
  background var(--color-theme-bg)
  backdrop-filter saturate(180%) blur(0.4rem)
  background-color var(--color-header-bg)
  z-index 99
}

.header_list {
  padding 10px 10px 10px 13px 
  border-bottom 1px solid var(--color-header-border)
  .logo {
    padding-right 24px
    text-align left
    svg {
      height 37px
      width 136px
    }
  }
}

.search_list {
  padding 79px 27px 
  a {
    font-size 16px
    strong {
      font-weight bold
    }
    .kw {
      color #f00
      font-style inherit
      font-weight bold
    }
    &:hover {
      .kw {
        color #333
      }
    }
  }
  li {
    padding 10px 0 10px 0
    list-style-type none
    p {
      padding-top 5px
      color #4F4F4F
    }
  }
}

.hotlist {
  padding 79px 27px 
  a {
    font-size 16px
    strong {
      font-weight bold
    }
  }
  li {
    padding 5px 0 5px 0
    list-style-type none
    p{
      padding-top 5px
      color #4F4F4F
    }
  }
}

.header_list .header_inner {
  display: flex;
  align-items: center;
  .search {
    flex: 1;
    display: flex;
  }
}

.header_inner, .hotlist, .search_list, .contributors {
  max-width 920px
  margin 0 auto
}

.contributors {
  padding 79px 27px
  max-width: 960px;
  font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji";
  font-size: 16px;
  line-height: 1.5;
  word-wrap: break-word;
  a {
    font-weight: bold;
  }
  .links {
    display: inline-flex;
    flex-wrap: wrap;
  }
  .links a {
    background: var(--color-theme-bg);
    height: 2.1rem;
    border-radius: 0.3rem;
    gap: 0.1rem;
    padding: 0rem 0.5rem 0rem 0.4rem;
  }
}

.doc-outline {
  background var(--color-theme-bg)
  border 1px solid var(--color-header-border)
  border-radius 8px
  box-shadow 0 12px 34px rgba(0,0,0,0.10)
  max-height calc(100vh - 128px)
  overflow auto
  padding 12px
  position fixed
  right 18px
  top 88px
  width 230px
  z-index 80
  nav {
    display flex
    flex-direction column
    gap 1px
  }
}

.doc-outline-title {
  color #666
  font-size 13px
  font-weight bold
  margin-bottom 8px
}

.doc-outline-link {
  border-radius 5px
  color currentColor
  display block
  font-size 13px
  line-height 1.35
  overflow hidden
  padding 6px 8px
  text-decoration none
  text-overflow ellipsis
  white-space nowrap
  &:hover {
    background var(--color-hover)
  }
}

.doc-outline-link.level-h3 {
  color #666
  font-size 12px
  padding-left 18px
}

.doc-outline-link.is-active {
  background var(--color-hover)
  color #0969da
  font-weight bold
}

.doc-outline-toggle {
  display none
}

.editor-page {
  padding 86px 24px 32px
  max-width 1080px
  margin 0 auto
}

.editor-toolbar {
  display flex
  align-items flex-end
  justify-content space-between
  gap 16px
  margin-bottom 14px
  h1 {
    font-size 24px
    line-height 1.25
    margin 0
  }
  p {
    color #777
    font-size 13px
    margin 6px 0 0
  }
}

.editor-actions {
  display flex
  flex-wrap wrap
  gap 8px
  justify-content flex-end
  a, button {
    border 1px solid var(--color-header-border)
    border-radius 6px
    background var(--color-theme-bg)
    color currentColor
    cursor pointer
    font-size 14px
    line-height 1.2
    padding 9px 12px
    text-decoration none
  }
  a:hover, button:hover {
    background var(--color-hover)
  }
}

.editor-status {
  border 1px solid var(--color-header-border)
  border-radius 6px
  color #666
  font-size 13px
  margin-bottom 14px
  padding 10px 12px
}

.editor-field {
  display block
  margin-bottom 14px
  span {
    color #666
    display block
    font-size 13px
    font-weight bold
    margin-bottom 7px
  }
  input {
    background transparent
    border 1px solid var(--color-header-border)
    border-radius 6px
    color currentColor
    display block
    font 15px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace
    outline 0
    padding 10px 12px
    width 100%
  }
  input:focus {
    border-color #66afe9
    box-shadow 0 0 0 3px rgba(102,175,233,0.18)
  }
}

.editor-pane {
  border 1px solid var(--color-header-border)
  border-radius 8px
  min-width 0
  overflow hidden
}

.editor-pane-title {
  border-bottom 1px solid var(--color-header-border)
  color #666
  font-size 13px
  font-weight bold
  padding 10px 12px
}

.editor-source textarea {
  background transparent
  border 0
  color currentColor
  display block
  font 14px/1.65 ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace
  min-height calc(100vh - 245px)
  outline 0
  padding 16px
  resize vertical
  width 100%
}

@media mq-mobile {
  .header{
    width inherit
    .search .enter-input {
      button {
        padding 9px 14px
      }
    }
  }
  .header_list {
    padding: 10px 10px 10px 13px
    .logo {
      float inherit
      padding-right 10px
      text-align center
    }
    .logo svg {
      width 96px
    }
    .search {
      .query {
        line-height 31px
      }
    }
  }
  .search_list, .hotlist {
    padding 78px 27px
  }
  .recent-visits {
    margin-top 18px
    padding 0 14px
  }
  .recent-visits-list {
    grid-template-columns 1fr
  }
  .editor-page {
    padding 76px 14px 24px
  }
  .editor-toolbar {
    align-items flex-start
    flex-direction column
  }
  .editor-actions {
    justify-content flex-start
  }
  .doc-outline {
    bottom 64px
    box-shadow 0 12px 34px rgba(0,0,0,0.18)
    display none
    left 14px
    max-height 55vh
    right 14px
    top auto
    width auto
    z-index 1000
  }
  .doc-outline.is-open {
    display block
  }
  .doc-outline-toggle {
    background var(--color-theme-bg)
    border 1px solid var(--color-header-border)
    border-radius 999px
    bottom 14px
    box-shadow 0 8px 24px rgba(0,0,0,0.18)
    color currentColor
    cursor pointer
    display block
    font-size 14px
    font-weight bold
    padding 9px 14px
    position fixed
    right 14px
    z-index 1001
  }
}

@media screen and (max-width: 1420px) {
  .doc-outline {
    display none
  }
  .doc-outline.is-open {
    display block
  }
  .doc-outline-toggle {
    background var(--color-theme-bg)
    border 1px solid var(--color-header-border)
    border-radius 999px
    bottom 18px
    box-shadow 0 8px 24px rgba(0,0,0,0.18)
    color currentColor
    cursor pointer
    display block
    font-size 14px
    font-weight bold
    padding 9px 14px
    position fixed
    right 18px
    z-index 1001
  }
}
